{% set interface = network|selectattr('ifname', 'match', 'internal_.*')|first %}

interface {{ interface.ifname }}
{
    AdvSendAdvert on;
    AdvManagedFlag on;
    AdvOtherConfigFlag on;
    AdvHomeAgentFlag off;
    MinRtrAdvInterval {{ radvd_interval }};
    MaxRtrAdvInterval {{ radvd_interval * 10 }};

    prefix {{ networks.home.delegated.full }}
    {
        AdvOnLink on;
        AdvAutonomous off;
        AdvRouterAddr on;
    };
    {# prefix {{ networks.home.slaac.full }}
    {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr on;
    }; #}
    {#
    # AdvRASrcAddress
    # {
    #     {{ interface.ip.ipv6.ip }};
    # }

    # route {{ networks.home.subnet.ipv6.full }} {};
    -#}
    RDNSS {{ networks.home.gateway.ipv6.ip }} {};

    DNSSL {{ networks.home.domain }} {};
};
