[log]
enabled=false
file={{ homed_log_root }}/zigbee_{{ i_zigbee_instance.name }}
timestamps=false

[mqtt]
host={{ homed_mqtt_host }}
port={{ homed_mqtt_port }}
username={{ mqtt_users.homed.login }}
password={{ mqtt_users.homed.pw }}
prefix=homed
names=true
debounce=false
instance={{ i_zigbee_instance.name }}

[homeassistant]
enabled=false
prefix=homeassistant
status=homeassistant/status

[default]
discovery=true
cloud=true

[device]
database={{ homed_zigbee_data_root }}/{{ i_zigbee_instance.name }}/database.json
properties={{ homed_zigbee_data_root }}/{{ i_zigbee_instance.name }}/properties.json
options={{ homed_zigbee_data_root }}/{{ i_zigbee_instance.name }}/options.json
external={{ homed_zigbee_data_root }}/external
library=/usr/share/homed-zigbee
join=disabled
ota={{ homed_zigbee_data_root }}/ota

[gpio]
status=-1
blink=-1
boot=-1
reset=-1

[zigbee]
adapter={{ i_zigbee_instance.controller.adapter }}
port={{ i_zigbee_instance.controller.port }}
baudrate={{ i_zigbee_instance.controller.baudrate }}
panid={{ i_zigbee_instance.network.pan_id }}
channel={{ i_zigbee_instance.network.channel }}
reset=soft
write={{ i_zigbee_instance.controller.write | string | lower }}
power={{ i_zigbee_instance.controller.power }}

[security]
enabled=true
key={{ i_zigbee_instance.network.key }}

[debug]
port=false
adapter=false
zigbee=true
